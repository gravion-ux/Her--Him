# Normalise every text file to LF in the repository and in the working tree.
# Without this, Windows checkouts (core.autocrlf=true) rewrite LF as CRLF and
# produce line-ending-only diffs on every file a contributor touches.
* text=auto eol=lf

# Windows-native scripts still need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Media assets are binary; never let Git try to normalise or diff them.
*.wav binary
*.mp3 binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
